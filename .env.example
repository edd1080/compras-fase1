# Copiar a .env y completar con los valores de cada entorno.
# NUNCA commitear .env; usar las variables de entorno del proveedor (Vercel) por entorno.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base de datos para migraciones (scripts/db-migrate.sh, db-reset.sh, db-seed.sh)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Correo transaccional (sprints posteriores)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Claude API (sprints posteriores)
ANTHROPIC_API_KEY=
